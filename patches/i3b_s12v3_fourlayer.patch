From be2c0f94d47104a383f4dd6644610e0a25f0f284 Mon Sep 17 00:00:00 2001
From: paicat1 <573148556@qq.com>
Date: Sun, 18 Oct 2026 14:04:34 +0800
Subject: [PATCH] I3b S12-internal v3: op-group stamps on four fixed layers
 (first / 1-3 / 2-3 / last) + MTP draft split; slots 12->26
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

APPROVED: 先做完再等我指示
---
 .../src/models/qwen3_5/execution/text.cpp     | 43 +++++++++----
 .../qwen3_5/program/speculative/mtp.cpp       |  6 +-
 .../program/speculative/step_graph_profile.h  |  2 +
 .../src/ops/launcher/speculative_round.cu     | 60 +++++++++++--------
 4 files changed, 71 insertions(+), 40 deletions(-)

diff --git a/src-tree/fusion-engine-src/src/models/qwen3_5/execution/text.cpp b/src-tree/fusion-engine-src/src/models/qwen3_5/execution/text.cpp
index 2d78a38..083c7be 100644
--- a/src-tree/fusion-engine-src/src/models/qwen3_5/execution/text.cpp
+++ b/src-tree/fusion-engine-src/src/models/qwen3_5/execution/text.cpp
@@ -1223,14 +1223,29 @@ void TextContext::run_stage_layers(std::size_t stage, Tensor& x, Phase ph, Tap&
             if (layer < layer_ready_.size()) {
                 CUDA_CHECK(cudaStreamWaitEvent(ctx_.stream, layer_ready_[layer], 0));
             }
-            // v4.4 op-group sampling (plan section 4.2): the stage's FIRST and LAST layers are always
-            // stamped, so every capture has the same node count (a rotating sample changed the topology
-            // between captures and made cudaGraphExecUpdate fail). The start stamp sits after the
-            // readiness wait so the delta measures in-layer time only.
-            const bool sample_first = sample_groups && layer == parameters_.text.stage_begin[stage];
-            const bool sample_last  = sample_groups && layer + 1 == end;
-            if (sample_first) { step_graph_record(12, ctx_.stream); }
-            if (sample_last)  { step_graph_record(15, ctx_.stream); }
+            // v4.5 op-group sampling (plan section 4.2): FOUR fixed layers (first, 1/3, 2/3, last) are
+            // always stamped, so every capture carries the same node count (a rotating sample changed
+            // the topology between captures and made cudaGraphExecUpdate fail). The start stamps sit
+            // after the readiness wait so each delta measures in-layer time only.
+            int sample_group = -1;
+            if (sample_groups) {
+                const std::uint32_t begin = parameters_.text.stage_begin[stage];
+                const std::uint32_t span  = end > begin ? end - 1 - begin : 0;
+                const std::uint32_t l1    = begin + span / 3;
+                const std::uint32_t l2    = begin + (span * 2) / 3;
+                if (layer == begin) { sample_group = 0; }
+                else if (span >= 3 && layer == l1) { sample_group = 1; }
+                else if (span >= 3 && layer == l2) { sample_group = 2; }
+                else if (layer + 1 == end) { sample_group = 3; }
+                if (layer == begin) {
+                    step_stamp_note_sample_layers(static_cast<int>(begin), static_cast<int>(l1),
+                                                  static_cast<int>(l2), static_cast<int>(end - 1));
+                }
+            }
+            if (sample_group == 0) { step_graph_record(12, ctx_.stream); }
+            if (sample_group == 1) { step_graph_record(15, ctx_.stream); }
+            if (sample_group == 2) { step_graph_record(18, ctx_.stream); }
+            if (sample_group == 3) { step_graph_record(21, ctx_.stream); }
             {
                 nvtx::ScopedRange mixer_range(
                     full ? (prefill ? nvtx::Name::PrefillAttention : nvtx::Name::VerifyAttention)
@@ -1243,8 +1258,10 @@ void TextContext::run_stage_layers(std::size_t stage, Tensor& x, Phase ph, Tap&
                     gdn_mix(block, x, compact, ph);
                 }
             }
-            if (sample_first) { step_graph_record(13, ctx_.stream); }
-            if (sample_last)  { step_graph_record(16, ctx_.stream); }
+            if (sample_group == 0) { step_graph_record(13, ctx_.stream); }
+            if (sample_group == 1) { step_graph_record(16, ctx_.stream); }
+            if (sample_group == 2) { step_graph_record(19, ctx_.stream); }
+            if (sample_group == 3) { step_graph_record(22, ctx_.stream); }
             {
                 nvtx::ScopedRange range(prefill ? nvtx::Name::PrefillPostMixer
                                                 : nvtx::Name::VerifyPostMixer,
@@ -1257,8 +1274,10 @@ void TextContext::run_stage_layers(std::size_t stage, Tensor& x, Phase ph, Tap&
                          layer + 1 < end ? next_projection_hints(static_cast<int>(layer))
                                          : ops::SparseMoeHints{});
             }
-            if (sample_first) { step_graph_record(14, ctx_.stream); }
-            if (sample_last)  { step_graph_record(17, ctx_.stream); }
+            if (sample_group == 0) { step_graph_record(14, ctx_.stream); }
+            if (sample_group == 1) { step_graph_record(17, ctx_.stream); }
+            if (sample_group == 2) { step_graph_record(20, ctx_.stream); }
+            if (sample_group == 3) { step_graph_record(23, ctx_.stream); }
             if constexpr (Tap::enabled) {
                 tap.capture_layer(static_cast<int>(layer), x, ctx_.stream);
             }
diff --git a/src-tree/fusion-engine-src/src/models/qwen3_5/program/speculative/mtp.cpp b/src-tree/fusion-engine-src/src/models/qwen3_5/program/speculative/mtp.cpp
index e1fc0de..83136d1 100644
--- a/src-tree/fusion-engine-src/src/models/qwen3_5/program/speculative/mtp.cpp
+++ b/src-tree/fusion-engine-src/src/models/qwen3_5/program/speculative/mtp.cpp
@@ -20,7 +20,7 @@ namespace ninfer::models::qwen3_5::execution {
 //   6 = "prepare 后/verify 前"；7 备用。arm 在建图前创建，record 在（被捕获的）
 // 图体内成为 event-record 节点（eager 期即真实记录），replay 后由 harvest 读回。
 namespace {
-constexpr int kStepSlots = 20;  // S9（7/8/9 = verify 内部）；v4.4（12-17 = 首/末层 op 组，18/19 = MTP draft 内部）
+constexpr int kStepSlots = 26;  // S9（7/8/9 = verify 内部）；v4.5（12-23 = 四层 op 组，24/25 = MTP draft 内部）
 cudaEvent_t g_step_graph_events[kStepSlots] = {nullptr};
 } // namespace
 
@@ -277,7 +277,7 @@ auto mtp_decode_batch_body(MtpBatchContext& state, std::int32_t batch_size,
                                         static_cast<std::int32_t>(draft_window),
                                         static_cast<std::int32_t>(state.text_cache.max_context()),
                                         state.execution.device.stream);
-            step_graph_record(18, state.execution.device.stream);  // v4.4: draft 准备段结束
+            step_graph_record(24, state.execution.device.stream);  // v4.5: draft 准备段结束
             card.mtp_forward_decode_batch(alignment_ids, target_hidden, target_positions,
                                           target_rope, licensed_counts, mtp_rows, envelopes.batch,
                                           alignment_hidden);
@@ -287,7 +287,7 @@ auto mtp_decode_batch_body(MtpBatchContext& state, std::int32_t batch_size,
             Tensor proposal_logits = frame.proposal_logits.slice(1, 0, batch_size);
             Tensor draft0          = next_drafts.slice(1, 0, 1).view({batch_size});
             card.mtp_propose_batch(ar_hidden, proposal_logits, draft0);
-            step_graph_record(19, state.execution.device.stream);  // v4.4: draft 首轮结束（循环起点）
+            step_graph_record(25, state.execution.device.stream);  // v4.5: draft 首轮结束（循环起点）
             for (std::uint32_t step = 0; step + 1 < draft_window; ++step) {
                 Tensor previous =
                     next_drafts.slice(1, static_cast<std::int32_t>(step), 1).view({batch_size});
diff --git a/src-tree/fusion-engine-src/src/models/qwen3_5/program/speculative/step_graph_profile.h b/src-tree/fusion-engine-src/src/models/qwen3_5/program/speculative/step_graph_profile.h
index 417fe90..98b837c 100644
--- a/src-tree/fusion-engine-src/src/models/qwen3_5/program/speculative/step_graph_profile.h
+++ b/src-tree/fusion-engine-src/src/models/qwen3_5/program/speculative/step_graph_profile.h
@@ -24,5 +24,7 @@ bool step_graph_harvest(double out_ms[4]);
 bool step_stamp_arm();
 void step_stamp_launch(int slot, cudaStream_t stream);
 void step_stamp_report(const char* tag);
+// v4.5：四个被采样层的真实层号走主机侧（内核只写 %globaltimer）；由 report 打印
+void step_stamp_note_sample_layers(int l0, int l1, int l2, int l3);
 
 } // namespace ninfer::models::qwen3_5::execution
diff --git a/src-tree/fusion-engine-src/src/ops/launcher/speculative_round.cu b/src-tree/fusion-engine-src/src/ops/launcher/speculative_round.cu
index 7ecad50..e24d445 100644
--- a/src-tree/fusion-engine-src/src/ops/launcher/speculative_round.cu
+++ b/src-tree/fusion-engine-src/src/ops/launcher/speculative_round.cu
@@ -223,6 +223,7 @@ unsigned long long* g_stamp_host = nullptr;  // mapped host view (zero-copy read
 unsigned long long* g_stamp_dev = nullptr;   // device view written by the stamp kernel
 int g_stamp_ref_prints = 0;
 int g_stamp_slow_prints = 0;
+int g_stamp_sample_layers[4] = {-1, -1, -1, -1};  // v4.5: 四个被采样层的真实层号（主机侧）
 
 __global__ void step_stamp_kernel(unsigned long long* out, int slot) {
     if (threadIdx.x == 0 && blockIdx.x == 0) {
@@ -236,7 +237,7 @@ __global__ void step_stamp_kernel(unsigned long long* out, int slot) {
 bool step_stamp_arm() {
     if (g_stamp_host != nullptr) { return true; }
     void* host = nullptr;
-    if (cudaHostAlloc(&host, sizeof(unsigned long long) * 20, cudaHostAllocMapped) != cudaSuccess) {
+    if (cudaHostAlloc(&host, sizeof(unsigned long long) * 26, cudaHostAllocMapped) != cudaSuccess) {
         (void)cudaGetLastError();
         return false;
     }
@@ -248,25 +249,33 @@ bool step_stamp_arm() {
     }
     g_stamp_host = static_cast<unsigned long long*>(host);
     g_stamp_dev = static_cast<unsigned long long*>(dev);
-    for (int i = 0; i < 20; ++i) { g_stamp_host[i] = 0ULL; }
-    std::fprintf(stderr, "[ninfer] spin-stamp DEBUG: armed (mapped host buffer, 20 slots)\n");
+    for (int i = 0; i < 26; ++i) { g_stamp_host[i] = 0ULL; }
+    std::fprintf(stderr, "[ninfer] spin-stamp DEBUG: armed (mapped host buffer, 26 slots)\n");
     return true;
 }
 
 void step_stamp_launch(int slot, cudaStream_t stream) {
-    if (g_stamp_dev == nullptr || slot < 0 || slot > 19) { return; }  // S9: 12 槽；v4.4: 20 槽（12-17 层 op 组，18/19 draft 内部）
+    if (g_stamp_dev == nullptr || slot < 0 || slot > 25) { return; }  // S9: 12 槽；v4.5: 26 槽（12-23 四层 op 组，24/25 draft 内部）
     step_stamp_kernel<<<1, 1, 0, stream>>>(g_stamp_dev, slot);
 }
 
+// v4.5：四个被采样层的真实层号——由 text.cpp 在算出采样集时回报（幂等；内核只写 %globaltimer）。
+void step_stamp_note_sample_layers(int l0, int l1, int l2, int l3) {
+    g_stamp_sample_layers[0] = l0; g_stamp_sample_layers[1] = l1;
+    g_stamp_sample_layers[2] = l2; g_stamp_sample_layers[3] = l3;
+}
+
 void step_stamp_report(const char* tag) {
     if (g_stamp_host == nullptr) { return; }
     const unsigned long long t0 = g_stamp_host[0], t1 = g_stamp_host[1], t2 = g_stamp_host[2];
     const unsigned long long t3 = g_stamp_host[3], t4 = g_stamp_host[4];
     const unsigned long long t5 = g_stamp_host[5], t6 = g_stamp_host[6];  // S7/E2: target 子界
     const unsigned long long t7 = g_stamp_host[7], t8 = g_stamp_host[8], t9 = g_stamp_host[9];  // S9: verify 内部
-    const unsigned long long t12 = g_stamp_host[12], t13 = g_stamp_host[13], t14 = g_stamp_host[14];  // v4.4: 首层
-    const unsigned long long t15 = g_stamp_host[15], t16 = g_stamp_host[16], t17 = g_stamp_host[17];  // v4.4: 末层
-    const unsigned long long t18 = g_stamp_host[18], t19 = g_stamp_host[19];  // v4.4: draft 内部
+    const unsigned long long t12 = g_stamp_host[12], t13 = g_stamp_host[13], t14 = g_stamp_host[14];  // v4.5: L0
+    const unsigned long long t15 = g_stamp_host[15], t16 = g_stamp_host[16], t17 = g_stamp_host[17];  // v4.5: L1
+    const unsigned long long t18 = g_stamp_host[18], t19 = g_stamp_host[19], t20 = g_stamp_host[20];  // v4.5: L2
+    const unsigned long long t21 = g_stamp_host[21], t22 = g_stamp_host[22], t23 = g_stamp_host[23];  // v4.5: L3
+    const unsigned long long t24 = g_stamp_host[24], t25 = g_stamp_host[25];  // v4.5: draft 内部
     if (t0 == 0ULL || t4 == 0ULL || t4 <= t0) { return; }
     const double total_ms = static_cast<double>(t4 - t0) / 1e6;
     const bool verbose = std::getenv("NINFER_SPIN_STAMP_VERBOSE") != nullptr;
@@ -306,25 +315,26 @@ void step_stamp_report(const char* tag) {
                      tag ? tag : "round", v_forward, v_accept, v_select, v_scatter,
                      v_forward + v_accept + v_select + v_scatter, d1);
     }
-    // v4.4：首/末层 op 组（槽 12-14 / 15-17）——固定两层，故每次 capture 节点数恒定（轮转版会触发
-    // cudaGraphExecUpdateFailure(result 2, TopologyChanged)，已撤）。层首戳取在 readiness wait 之后。
-    if (t12 != 0ULL && t13 >= t12 && t14 >= t13) {
-        const double m0 = static_cast<double>(t13 - t12) / 1e6;
-        const double p0 = static_cast<double>(t14 - t13) / 1e6;
-        std::fprintf(stderr, "[ninfer] layer-ops %s: first mixer=%.2f mlp_tail=%.2f ms | sum=%.2f\n",
-                     tag ? tag : "round", m0, p0, m0 + p0);
-    }
-    if (t15 != 0ULL && t16 >= t15 && t17 >= t16) {
-        const double m1 = static_cast<double>(t16 - t15) / 1e6;
-        const double p1 = static_cast<double>(t17 - t16) / 1e6;
-        std::fprintf(stderr, "[ninfer] layer-ops %s: last  mixer=%.2f mlp_tail=%.2f ms | sum=%.2f\n",
-                     tag ? tag : "round", m1, p1, m1 + p1);
+    // v4.5：四层 op 组（槽 12-14 / 15-17 / 18-20 / 21-23）。固定集合 ⇒ 每次 capture 节点数恒定
+    //（轮转版曾触发 cudaGraphExecUpdateFailure result 2 TopologyChanged，已撤）。层首戳取在 wait 之后。
+    {
+        const unsigned long long a[4][3] = {{t12, t13, t14}, {t15, t16, t17},
+                                            {t18, t19, t20}, {t21, t22, t23}};
+        for (int i = 0; i < 4; ++i) {
+            if (a[i][0] != 0ULL && a[i][1] >= a[i][0] && a[i][2] >= a[i][1]) {
+                const double m = static_cast<double>(a[i][1] - a[i][0]) / 1e6;
+                const double p = static_cast<double>(a[i][2] - a[i][1]) / 1e6;
+                std::fprintf(stderr,
+                             "[ninfer] layer-ops %s: L%d layer=%d mixer=%.2f mlp_tail=%.2f ms | sum=%.2f\n",
+                             tag ? tag : "round", i, g_stamp_sample_layers[i], m, p, m + p);
+            }
+        }
     }
-    // v4.4：MTP draft 内部三段（槽 18/19 与 t2/t3 拼）——Σ 应等于 draft 段（t3-t2）
-    if (t18 != 0ULL && t19 >= t18 && t3 >= t19 && t3 >= t2) {
-        const double d_prepare = static_cast<double>(t18 - t2) / 1e6;
-        const double d_first   = static_cast<double>(t19 - t18) / 1e6;
-        const double d_loop    = static_cast<double>(t3 - t19) / 1e6;
+    // v4.5：MTP draft 内部三段（槽 24/25 与 t2/t3 拼）——Σ 应等于 draft 段（t3-t2）
+    if (t24 != 0ULL && t25 >= t24 && t3 >= t25 && t3 >= t2) {
+        const double d_prepare = static_cast<double>(t24 - t2) / 1e6;
+        const double d_first   = static_cast<double>(t25 - t24) / 1e6;
+        const double d_loop    = static_cast<double>(t3 - t25) / 1e6;
         std::fprintf(stderr, "[ninfer] draft-split %s: prepare=%.2f first=%.2f loop=%.2f ms | sum=%.2f (draft=%.1f)\n",
                      tag ? tag : "round", d_prepare, d_first, d_loop, d_prepare + d_first + d_loop, d2);
     }
