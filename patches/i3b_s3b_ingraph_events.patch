index c934aa5..d1788b3 100644
--- a/src-tree/fusion-engine-src/src/core/decode_graph.cpp
+++ b/src-tree/fusion-engine-src/src/core/decode_graph.cpp
@@ -4,6 +4,7 @@
 #include "core/nvtx.h"
 
 #include <cstdio>
+#include <cstdlib>
 #include <stdexcept>
 #include <string>
 
@@ -78,6 +79,15 @@ void DecodeGraphDefinition::capture(cudaStream_t stream, const std::function<voi
     }
 
     graph_ = graph;
+    {   // I3b S3b：capture 后节点计数（门槛同 NINFER_STEP_PROFILE；仅建图期一行）
