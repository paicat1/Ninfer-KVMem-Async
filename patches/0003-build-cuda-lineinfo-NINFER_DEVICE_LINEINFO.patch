- CMakeLists.txt 新增 option(NINFER_DEVICE_LINEINFO ... OFF)
- ninfer_cuda_archive 与 ninfer_cuda_non_rdc_archive 仅在开关 ON 时追加 -lineinfo
- 发布构建默认不携带设备 lineinfo；诊断构建显式传 -DNINFER_DEVICE_LINEINFO=ON
---
 src-tree/fusion-engine-src/CMakeLists.txt        |  4 ++++
 .../fusion-engine-src/cmake/NinferTargets.cmake  | 16 ++++++++++++++--
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/src-tree/fusion-engine-src/CMakeLists.txt b/src-tree/fusion-engine-src/CMakeLists.txt
index 72a9615..ef48457 100644
--- a/src-tree/fusion-engine-src/CMakeLists.txt
+++ b/src-tree/fusion-engine-src/CMakeLists.txt
@@ -210,6 +210,10 @@ if(NINFER_BUILD_APPS OR BUILD_TESTING)
   set(NINFER_BUILD_PRODUCT_SUPPORT ON)
 endif()
 
+# 2026-11-27 (user approved): CUDA device line info switch, default OFF so release
+#   artifacts are bit-reproducible; profile builds pass -DNINFER_DEVICE_LINEINFO=ON.
+option(NINFER_DEVICE_LINEINFO "Emit device line info; diagnostic builds only, breaks bit-repro" OFF)
+
 include(cmake/Dependencies.cmake)
 include(cmake/NinferTargets.cmake)
 
diff --git a/src-tree/fusion-engine-src/cmake/NinferTargets.cmake b/src-tree/fusion-engine-src/cmake/NinferTargets.cmake
index 4d9de63..a8b1420 100644
--- a/src-tree/fusion-engine-src/cmake/NinferTargets.cmake
+++ b/src-tree/fusion-engine-src/cmake/NinferTargets.cmake
@@ -14,7 +14,13 @@ function(ninfer_cuda_archive target)
   if(WIN32)
     set_target_properties(${target} PROPERTIES CUDA_RUNTIME_LIBRARY Static)
   endif()
-  target_compile_options(${target} PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:-lineinfo>)
+  # 2026-11-27 (user approved): release recipe carries NO device line info by default.
+  #   Reason: -lineinfo writes the random nvcc temp filename into every cubin, so
+  #   two clean builds never match (T-BUILD-TWICE). Diagnostic builds pass
+  #   -DNINFER_DEVICE_LINEINFO=ON explicitly.
+  if(NINFER_DEVICE_LINEINFO)
+    target_compile_options(${target} PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:-lineinfo>)
+  endif()
 endfunction()
 
 function(ninfer_cuda_non_rdc_archive target)
@@ -24,7 +30,13 @@ function(ninfer_cuda_non_rdc_archive target)
   if(WIN32)
     set_target_properties(${target} PROPERTIES CUDA_RUNTIME_LIBRARY Static)
   endif()
-  target_compile_options(${target} PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:-lineinfo>)
+  # 2026-11-27 (user approved): release recipe carries NO device line info by default.
+  #   Reason: -lineinfo writes the random nvcc temp filename into every cubin, so
+  #   two clean builds never match (T-BUILD-TWICE). Diagnostic builds pass
+  #   -DNINFER_DEVICE_LINEINFO=ON explicitly.
+  if(NINFER_DEVICE_LINEINFO)
+    target_compile_options(${target} PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:-lineinfo>)
+  endif()
 endfunction()
 
 # Runtime DLL staging for the apps and tests.
