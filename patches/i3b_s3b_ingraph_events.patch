diff --git a/src-tree/fusion-engine-src/src/models/qwen3_5/program/decode.cpp b/src-tree/fusion-engine-src/src/models/qwen3_5/program/decode.cpp
index e8c65fc..69a18e9 100644
--- a/src-tree/fusion-engine-src/src/models/qwen3_5/program/decode.cpp
+++ b/src-tree/fusion-engine-src/src/models/qwen3_5/program/decode.cpp
@@ -4,6 +4,7 @@
 #include "models/qwen3_5/program/context.h"
 #include "models/qwen3_5/program/graph_execution.h"
